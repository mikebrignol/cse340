<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
        <h2>Project Details</h2>
        <li><strong><%= project.title %></strong>: <%= project.description %> (<%= project.project_date %>, <%= project.location %>) partner: <a href="/organizations/<%= project.organization_id %>"><%= project.name %></a> <br> <a href="/project/<%= project.project_id %>">View Details</a></li>
        <p><a href="/categories/<%= project.category_id %>">View Category</a></p>

<% if (user) { %>

  <% if (!isVolunteer) { %>
    <form action="/project/<%= project.project_id %>/volunteer" method="POST">
      <button>Volunteer for this project</button>
    </form>
  <% } else { %>
    <p>You are volunteering for this project</p>
        <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
      <button>Remove volunteering</button>
    </form>
  <% } %>

<% } %>

<% if (user && user.role_name === 'admin') { %>
    <p><a href="/edit-project/<%= project.project_id %>">Edit Project</a></p>
    <p><a href="/assign-categories/<%= project.project_id %>">Assign Categories</a></p>
<% } %>

</main>

<%- include('partials/footer') %>